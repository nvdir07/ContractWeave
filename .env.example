# watsonx.ai credentials (primary LLM runtime)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ollama fallback (used when WATSONX_API_KEY is absent)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=granite3.3:8b

# watsonx.ai model
WATSONX_MODEL=ibm/granite-3-3-8b-instruct

# Orchestrate skill server port
SKILL_PORT=3333
